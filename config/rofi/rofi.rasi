/* Settings */
configuration {
    font: "Inter SemiBold 10.5";
    show-icons: true;
    icon-theme: "MoreWaita";
    modi: "drun,window,recursivebrowser,calculator:~/.config/rofi/scripts/calculator.sh";
    display-drun: "⎇ 1  󰕰";
    display-window: "⎇ 2  ";
    display-recursivebrowser: "⎇ 3  ";
    display-calculator: "⎇ 4  󰃬";
    window-format: "{t}";
    window-thumbnail: true;
    terminal: "/usr/bin/alacritty";
    kb-element-prev: "";
    kb-element-next: "";
    kb-mode-previous: "ISO_Left_Tab";
    kb-mode-next: "Tab";
}

/* Styling */
@theme "dark"

* {
    spacing: 0;
    highlight: none;
    background-color: @background-alt;
}

window {
    width: 750;
    height: 425;
    border-radius: 6;
}

mainbox {
    children: [ inputbar, textbox-results, listview, footer ];
}

spacer {
    content: "";
    expand: true;
    background-color: transparent;
}

inputbar {
    children: [ entry, textbox-return-icon ];
    padding: 15 20;
    background-color: @background-alt;
}

entry {
    background-color: inherit;
    color: @foreground;
    placeholder: "Start typing here...";
    placeholder-color: @foreground-alt;
    vertical-align: 0.5;
    cursor: text;
}

textbox-return-icon {
    font: "JetBrainsMono NFP Regular 12";
    content: "󰌑";
    background-color: @raised;
    color: @foreground-alt;
    expand: false;
    padding: 0 6;
    border-radius: 3;
    margin: 0 0 0 8;
}

textbox-results {
    content: "Results";
    expand: false;
    background-color: @background;
    color: @foreground-alt;
    padding: 15 20;
}

listview {
    padding: 0 20 10 20;
    background-color: @background;
    lines: 6;
    scrollbar: true;
}

element {
    background-color: inherit;
    border-radius: 10;
    padding: 10;
    spacing: 15;
    cursor: pointer;
}

element.selected {
    background-color: @selected;
}

element-icon {
    size: 25;
    background-color: inherit;
    cursor: pointer;
}

element-text {
    background-color: inherit;
    color: @foreground-alt;
    vertical-align: 0.5;
    cursor: pointer;
}

element-text.selected {
    color: @foreground;
}

scrollbar {
    handle-color: @scroll;
    margin: 0 0 0 10;
    background-color: inherit;
    handle-width: 4;
}

footer {
    children: [ mode-switcher, spacer, textbox-switch-icon, textbox-switch-text ];
    orientation: horizontal;
    background-color: @background-alt;
    color: @foreground-alt;
    padding: 8 20;
    height: 200;
    expand: false;
    spacing: 5;
}

mode-switcher {
    background-color: inherit;
    color: inherit;
    spacing: 5;
    width: 300;
}

button {
    background-color: @raised;
    color: inherit;
    border-radius: 3;
    padding: 0 6;
    cursor: pointer;
}

button.selected {
    color: @foreground;
}

textbox-switch-icon {
    font: "JetBrainsMono NFP Regular 12";
    content: "󰌒";
    background-color: @raised;
    color: inherit;
    expand: false;
    padding: 0 6;
    border-radius: 3;
}

textbox-switch-text {
    content: "Switch mode";
    background-color: inherit;
    color: inherit;
    vertical-align: 0.5;
    expand: false;
}
