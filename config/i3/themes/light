# Dark theme
set $background     "#ffffff"
set $background_alt "#fafafa"
set $foreground     "#333333"
set $foreground_alt "#999999"
set $urgent         "#ff7043"
set $empty          "#dddddd"
set $raised         "#e6e6e6"
set $full           "#ffffff"

# Window                Border          Background      Text            Indicator       Child border
client.focused          $raised         $raised         $foreground     $raised         $raised
client.focused_inactive $raised         $raised         $foreground_alt $raised         $raised
client.unfocused        $background     $background     $foreground_alt $background     $background
client.urgent           $urgent         $urgent         $foreground     $urgent         $urgent
client.placeholder      $background     $background     $foreground_alt $background     $background
client.background       $full
